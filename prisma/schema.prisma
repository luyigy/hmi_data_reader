generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id             String   @id @default(cuid())
  name           String
  type           String
  location       String?
  capabilities   String   // JSON array as string
  status         String   @default("offline") // online, offline, busy, error
  lastHeartbeat  DateTime @default(now())
  nodeId         String?
  node           Node?    @relation(fields: [nodeId], references: [id])
  tasks          Task[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([nodeId])
}

model Node {
  id          String   @id @default(cuid())
  name        String
  ip          String?
  status      String   @default("offline") // online, offline, maintenance
  resources   String?  // JSON object as string: { cpu, memory, disk }
  agents      Agent[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Task {
  id              String    @id @default(cuid())
  name            String
  description     String?
  status          String    @default("pending") // pending, running, completed, failed
  assignedAgents  Agent[]
  result          String?   // JSON result data
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model ChatRoom {
  id          String    @id @default(cuid())
  name        String
  description String?
  messages    Message[]
  createdAt   DateTime  @default(now())

  @@index([name])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  roomId    String
  userId    String
  userName  String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
}
