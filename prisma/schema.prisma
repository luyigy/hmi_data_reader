generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id             String    @id @default(cuid())
  name           String
  runtimeAgentId String?
  type           String
  location       String?
  capabilities   String    // JSON array as string
  status         String    @default("offline") // online, offline, busy, error
  lastHeartbeat  DateTime  @default(now())
  gatewayId      String?
  gateway        Gateway?  @relation(fields: [gatewayId], references: [id])

  // Agent Identity Management fields
  userNickname   String?   // 用户自定义昵称，如 "小C", "老王"
  roleDescription String?  // 角色描述，如 "前端开发专家", "代码审查员"
  colorTag       String?   // 颜色标签，用于 UI 区分，如 "#4A90E2"
  emojiIcon      String?   // 表情图标，如 "🤖", "🧠", "💻"
  hostname       String?   // 服务器主机名，用于区分不同服务器上的 platform_local agents

  tasks          Task[]
  liveRoomMembers LiveRoomMember[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([gatewayId])
  @@index([runtimeAgentId])
  @@index([hostname])
}

model Gateway {
  id              String            @id @default(cuid())
  name            String
  url             String?           // Gateway API URL (e.g., http://192.168.1.100:3000)
  token           String?           // Authentication token (encrypted)
  openclawToken   String?           // OpenClaw HTTP API token (encrypted)
  ip              String?           // Legacy field for backward compatibility
  status          String            @default("offline") // online, offline, maintenance
  resources       String?           // JSON object as string: { cpu, memory, disk }
  agents          Agent[]
  liveRoomMembers LiveRoomMember[]
  outgoingMessages GatewayMessage[] @relation("outgoingMessages")
  incomingMessages GatewayMessage[] @relation("incomingMessages")
  sentMessages    IncomingGatewayMessage[] @relation("sentMessages")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
}

model RemoteHarnessHost {
  id                 String   @id @default(cuid())
  label              String
  host               String
  port               Int      @default(22)
  sshUser            String
  authType           String   @default("ssh_key") // ssh_key
  encryptedPrivateKey String?
  workingDirectory   String?
  status             String   @default("offline") // online, offline, maintenance
  viaNetwork         String   @default("wireguard") // wireguard, lan, public
  supportedHarnesses String?  // JSON string array
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([label])
}

model Task {
  id                   String                  @id @default(cuid())
  name                 String
  description          String?
  status               String                  @default("pending") // pending, running, completed, failed
  executionMode        String                  @default("standard") // standard, acpx
  runnerTarget         String?                 // legacy ACPX field
  acpxParticipants     String?                 // JSON array of gateway/harness/role participants
  acpxPermissionConfig String?                 // JSON object of local Codex permission preferences
  workingDirectory     String?
  currentTaskSessionId String?
  liveRooms            LiveRoom[]
  assignedAgents       Agent[]
  result               String?                 // JSON result data
  error                String?
  startedAt            DateTime?
  completedAt          DateTime?
  runs                 TaskRun[]
  taskSessions         TaskSession[]
  controlMessages      TaskRunControlMessage[]
  interactionRequests  TaskRunInteractionRequest[]
  currentTaskSession   TaskSession?            @relation("TaskCurrentSession", fields: [currentTaskSessionId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status])
  @@index([executionMode])
  @@index([currentTaskSessionId])
}

model TaskRun {
  id                String                  @id @default(cuid())
  taskId            String
  taskSessionId     String?
  task              Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskSession       TaskSession?            @relation(fields: [taskSessionId], references: [id], onDelete: SetNull)
  mode              String                  @default("acpx") // acpx
  runnerTarget      String?                 // legacy ACPX field
  orchestrationMode String                  @default("single") // single, staged
  status            String                  @default("pending") // pending, running, completed, failed
  controlState      String                  @default("normal") // normal, interrupt_requested, stop_requested
  activityState     String                  @default("quiet") // streaming, quiet, stalled, waiting_user, terminating
  summary           String?
  error             String?
  watchdogConfig    String?                 // JSON
  controlMetadata   String?                 // JSON
  lastActivityAt    DateTime?
  lastStdoutAt      DateTime?
  lastStderrAt      DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  participants      TaskRunParticipant[]
  events            TaskRunEvent[]
  controlMessages   TaskRunControlMessage[]
  interactionRequests TaskRunInteractionRequest[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([taskId, createdAt])
  @@index([taskSessionId, createdAt])
  @@index([status])
}

model TaskRunParticipant {
  id                      String                  @id @default(cuid())
  taskRunId               String
  taskRun                 TaskRun                 @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  runner                  String?                 // legacy ACPX field
  executionBackend        String                  @default("gateway_openclaw") // platform_local, gateway_openclaw
  gatewayId               String?
  gatewayNameSnapshot     String
  harnessType             String
  harnessNameSnapshot     String?
  role                    String
  agentId                 String?
  agentNameSnapshot       String?
  status                  String                  @default("pending") // pending, running, completed, failed
  activityState           String                  @default("quiet") // streaming, quiet, stalled, waiting_user, terminating
  summary                 String?
  error                   String?
  filesModified           String?                 // JSON string array
  controlMetadata         String?                 // JSON
  lastActivityAt          DateTime?
  interruptSupported      Boolean                 @default(false)
  resumeSupported         Boolean                 @default(false)
  sessionControlSupported Boolean                 @default(false)
  softStopSupported       Boolean                 @default(false)
  startedAt               DateTime?
  completedAt             DateTime?
  events                  TaskRunEvent[]
  controlMessages         TaskRunControlMessage[]
  interactionRequests     TaskRunInteractionRequest[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([taskRunId])
  @@index([runner])
  @@index([status])
}

model TaskRunEvent {
  id               String              @id @default(cuid())
  taskRunId        String
  participantId    String?
  taskRun          TaskRun             @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  participant      TaskRunParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sequence         Int
  eventType        String
  stream           String              @default("system") // system, stdout, stderr
  content          String
  metadata         String?
  createdAt        DateTime            @default(now())

  @@index([taskRunId, sequence])
  @@index([participantId])
  @@index([eventType])
}

model TaskSession {
  id             String                  @id @default(cuid())
  taskId         String
  status         String                  @default("active") // active, waiting_user, paused, completed, failed
  attentionState String                  @default("normal") // normal, needs_review, needs_user_input, stuck, error
  activeRunId    String?
  summary        String?
  metadata       String?                 // JSON
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  task           Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runs           TaskRun[]
  controlMessages TaskRunControlMessage[]
  interactionRequests TaskRunInteractionRequest[]
  currentForTask Task[]                  @relation("TaskCurrentSession")

  @@index([taskId, createdAt])
  @@index([status])
  @@index([activeRunId])
}

model TaskRunControlMessage {
  id             String               @id @default(cuid())
  taskId         String
  taskSessionId  String?
  taskRunId      String
  roomMessageId  String?
  participantId  String?
  senderUserId   String
  senderName     String
  deliveryMode   String               @default("queued") // queued, immediate
  deliveryStatus String               @default("pending") // pending, delivered, superseded, rejected
  controlAction  String               @default("queue_message") // queue_message, interrupt_now, stop_run
  content        String
  metadata       String?              // JSON
  createdAt      DateTime             @default(now())
  processedAt    DateTime?
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskSession    TaskSession?         @relation(fields: [taskSessionId], references: [id], onDelete: SetNull)
  taskRun        TaskRun              @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  participant    TaskRunParticipant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([taskSessionId, createdAt])
  @@index([taskRunId, createdAt])
  @@index([participantId])
  @@index([deliveryStatus])
}

model TaskRunInteractionRequest {
  id               String              @id @default(cuid())
  taskId           String
  taskSessionId    String?
  taskRunId        String
  participantId    String?
  roomMessageId    String?
  source           String              @default("harness") // harness, system
  requestKind      String
  status           String              @default("pending") // pending, approved, denied, answered, expired, cancelled
  title            String?
  message          String
  rawPayload       String?
  optionsJson      String?
  defaultAnswer    String?
  responseText     String?
  responseMetadata String?
  requestedAt      DateTime            @default(now())
  resolvedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskSession      TaskSession?        @relation(fields: [taskSessionId], references: [id], onDelete: SetNull)
  taskRun          TaskRun             @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  participant      TaskRunParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([taskRunId, createdAt])
  @@index([participantId, status])
  @@index([status, expiresAt])
}

model ChatRoom {
  id          String    @id @default(cuid())
  name        String
  description String?
  messages    Message[]
  createdAt   DateTime  @default(now())

  @@index([name])
}

model Message {
  id                     String   @id @default(cuid())
  content                String
  roomId                 String
  userId                 String
  userName               String
  targetType             String   @default("task") // task, participant, all
  targetParticipantKey   String?
  targetParticipantLabel String?
  createdAt              DateTime @default(now())
  room                   ChatRoom @relation(fields: [roomId], references: [id])

  @@index([roomId, createdAt])
  @@index([roomId, targetType, createdAt])
}

model GatewayMessage {
  id            String   @id @default(cuid())
  fromGatewayId String
  toGatewayId   String
  fromGateway   Gateway  @relation("outgoingMessages", fields: [fromGatewayId], references: [id])
  toGateway     Gateway  @relation("incomingMessages", fields: [toGatewayId], references: [id])
  type          String   @default("direct") // direct, broadcast, request
  payload       String   // JSON payload
  status        String   @default("pending") // pending, sent, delivered, failed
  createdAt     DateTime @default(now())
  deliveredAt   DateTime?
  error         String?

  @@index([fromGatewayId])
  @@index([toGatewayId])
  @@index([status])
}

model IncomingGatewayMessage {
  id            String    @id @default(cuid())
  fromGatewayId String
  fromGateway   Gateway   @relation("sentMessages", fields: [fromGatewayId], references: [id])
  message       String    // JSON message
  type          String    @default("direct") // direct, broadcast, request
  status        String    @default("received") // received, processed, failed
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  error         String?

  @@index([fromGatewayId])
  @@index([status])
  @@index([receivedAt])
}

model ControlPlaneState {
  id              String   @id @default(cuid())
  gatewayId       String   @unique
  status          String   @default("offline") // online, offline, unhealthy, maintenance
  lastHeartbeat   DateTime @default(now())
  loadScore       Float    @default(0) // 0-100, lower is better
  latency         Int      @default(0) // ms
  consecutiveFails Int     @default(0)
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model CrossGatewayChatSession {
  id            String                    @id @default(cuid())
  fromGatewayId String
  toGatewayId   String
  fromAgentId   String                    @default("main")
  toAgentId     String                    @default("main")
  prompt        String
  turns         Int                       @default(2)
  status        String                    @default("completed") // completed, failed
  error         String?
  messages      CrossGatewayChatMessage[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([fromGatewayId])
  @@index([toGatewayId])
  @@index([createdAt])
  @@index([status])
}

model CrossGatewayChatMessage {
  id         String                  @id @default(cuid())
  sessionId  String
  sequence   Int
  speaker    String
  gatewayId  String?
  agentId    String?
  text       String
  createdAt  DateTime                @default(now())
  session    CrossGatewayChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequence])
  @@index([gatewayId])
}

model LiveRoom {
  id                     String                  @id @default(cuid())
  title                  String
  description            String?
  sourceTaskId           String?
  currentTopic           String?
  mode                   String                  @default("discussion") // discussion, execution, hybrid
  status                 String                  @default("active") // active, archived
  createdBy              String                  @default("user")
  currentSpeakerMemberId String?
  workingDirectory       String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sourceTask             Task?                   @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  currentSpeaker         LiveRoomMember?         @relation("LiveRoomCurrentSpeaker", fields: [currentSpeakerMemberId], references: [id], onDelete: SetNull)
  members                LiveRoomMember[]        @relation("LiveRoomMembers")
  messages               LiveRoomMessage[]
  sessions               LiveRoomMemberSession[]
  feishuBindings         FeishuConversationBinding[]

  @@index([sourceTaskId])
  @@index([status, updatedAt])
}

model FeishuConversationBinding {
  id                 String    @id @default(cuid())
  scopeKey           String    @unique
  chatId             String
  chatType           String
  senderOpenId       String?
  latestMessageId    String?
  typingReactionId   String?
  typingForMessageId String?
  liveRoomId         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  liveRoom           LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)

  @@index([chatId, updatedAt])
  @@index([liveRoomId])
}

model LiveRoomMember {
  id                   String                  @id @default(cuid())
  roomId               String
  agentRecordId        String?
  gatewayId            String?
  memberType           String                  @default("user") // user, local_agent, gateway_agent, system
  displayName          String
  agentNameSnapshot    String?
  harnessType          String?
  backend              String?                 // platform_local, gateway_openclaw
  runtimeAgentId       String?
  roleLabel            String?

  // Agent Identity Management fields
  userNickname         String?                 // 房间专属昵称（覆盖 Agent 级别的昵称）
  shortAlias           String?                 // 简短别名，用于 @提及，如 "小C", "lc"

  joinStatus           String                  @default("joined") // joined, invited, removed
  presenceStatus       String                  @default("idle") // idle, online, busy, offline
  canReply             Boolean                 @default(false)
  sortOrder            Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  room                 LiveRoom                @relation("LiveRoomMembers", fields: [roomId], references: [id], onDelete: Cascade)
  roomAsCurrentSpeaker LiveRoom[]              @relation("LiveRoomCurrentSpeaker")
  agentRecord          Agent?                  @relation(fields: [agentRecordId], references: [id], onDelete: SetNull)
  gateway              Gateway?                @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  sentMessages         LiveRoomMessage[]       @relation("LiveRoomMessageSender")
  sessions             LiveRoomMemberSession[]
  deliveries           LiveRoomDelivery[]

  @@index([roomId, sortOrder])
  @@index([agentRecordId])
  @@index([gatewayId])
  @@index([memberType, presenceStatus])
}

model LiveRoomMessage {
  id               String               @id @default(cuid())
  roomId           String
  senderMemberId   String?
  replyToMessageId String?
  messageType      String               @default("user") // user, assistant, system, tool, topic, control
  visibility       String               @default("room") // room, system
  content          String
  topicSnapshot    String?
  metadata         String?
  createdAt        DateTime             @default(now())
  room             LiveRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderMember     LiveRoomMember?      @relation("LiveRoomMessageSender", fields: [senderMemberId], references: [id], onDelete: SetNull)
  replyToMessage   LiveRoomMessage?     @relation("LiveRoomMessageReplyTo", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          LiveRoomMessage[]    @relation("LiveRoomMessageReplyTo")
  deliveries       LiveRoomDelivery[]

  @@index([roomId, createdAt])
  @@index([senderMemberId, createdAt])
  @@index([replyToMessageId])
  @@index([messageType, createdAt])
}

model LiveRoomMemberSession {
  id                    String                  @id @default(cuid())
  roomId                String
  memberId              String
  backend               String                  // platform_local, gateway_openclaw
  sessionKey            String
  threadId              String?
  status                String                  @default("online") // online, offline, busy, expired
  supportsStreaming     Boolean                 @default(false)
  supportsAppendMessage Boolean                 @default(true)
  supportsInterrupt     Boolean                 @default(false)
  lastHeartbeatAt       DateTime?
  lastDeliveredAt       DateTime?
  lastError             String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  room                  LiveRoom                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  member                LiveRoomMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deliveries            LiveRoomDelivery[]

  @@index([roomId, memberId])
  @@index([sessionKey])
  @@index([status, updatedAt])
}

model LiveRoomDelivery {
  id             String                  @id @default(cuid())
  roomMessageId  String
  targetMemberId String
  sessionId      String?
  deliveryStatus String                  @default("pending") // pending, delivered, failed, fallback
  fallbackReason String?
  attemptedAt    DateTime                @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime                @default(now())
  roomMessage    LiveRoomMessage         @relation(fields: [roomMessageId], references: [id], onDelete: Cascade)
  targetMember   LiveRoomMember          @relation(fields: [targetMemberId], references: [id], onDelete: Cascade)
  session        LiveRoomMemberSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([roomMessageId])
  @@index([targetMemberId, attemptedAt])
  @@index([sessionId])
  @@index([deliveryStatus, attemptedAt])
}
