[Unit]
Description=HMI GPU Recognition Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/data1/code/hmi_data_reader
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONUNBUFFERED=1
Environment=HMI_HOST=0.0.0.0
Environment=HMI_PORT=8765
ExecStart=/data1/code/hmi_data_reader/scripts/run_service.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
