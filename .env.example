# Database
DATABASE_URL="postgresql://agent_platform:change-me@127.0.0.1:5432/agent_platform?schema=public&connection_limit=10&pool_timeout=10"

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# Platform base URL
AGENT_PLATFORM_BASE_URL=http://localhost:3000
ACPX_CODEX_SANDBOX_MODE=workspace-write

# Optional: dedicated proxy settings restored only for Codex child processes
# spawned from the Feishu standalone runtime. This lets Feishu websocket
# traffic bypass proxy while Codex API traffic still uses one.
FEISHU_RUNTIME_CODEX_HTTP_PROXY=
FEISHU_RUNTIME_CODEX_HTTPS_PROXY=
FEISHU_RUNTIME_CODEX_ALL_PROXY=
FEISHU_RUNTIME_CODEX_NO_PROXY=

# WebSocket
SOCKET_PORT=3101
NEXT_PUBLIC_SOCKET_PORT=3101

# Debug (set to "true" to enable mention detection logging)
DEBUG_MENTION_DETECTION=false

# Feishu Bot
FEISHU_CONNECTION_MODE=long_connection
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Required for group triggers: only structured mentions of this bot are accepted.
FEISHU_BOT_OPEN_ID=
FEISHU_ADMIN_OPEN_ID=

# Optional gateway smoke test target
LINUX_GATEWAY_HOST=127.0.0.1
LINUX_GATEWAY_PORT=18789
LINUX_GATEWAY_TOKEN=

# Optional Antigravity CLI executable override (defaults to agy)
ANTIGRAVITY_CLI_PATH=
