[Unit]
Description=Agent Platform Scheduled Job Runner
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data1/code/agent-platform-v2
ExecStart=/data1/code/agent-platform-v2/scripts/run-scheduled-job-runner.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
