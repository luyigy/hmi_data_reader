[Unit]
Description=Agent Platform Next.js Dev Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data1/code/agent-platform-v2
ExecStart=/data1/code/agent-platform-v2/scripts/run-agent-platform-dev.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
