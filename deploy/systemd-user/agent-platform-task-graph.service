[Unit]
Description=Agent Platform Task Graph Coordinator
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data1/code/agent-platform-v2
ExecStart=/data1/code/agent-platform-v2/scripts/run-task-graph-runner.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
