{
  "name": "agent-platform-v2",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-platform-runner": "scripts/agent-platform-runner.js"
  },
  "scripts": {
    "db:migrate:sqlite": "node scripts/migrate-sqlite-to-postgresql.mjs",
    "db:verify:migration": "node scripts/verify-postgresql-migration.mjs",
    "predev": "prisma generate",
    "dev": "next dev -H 0.0.0.0 -p 3010",
    "feishu:runtime": "FEISHU_RUNTIME_CODEX_HTTP_PROXY=${http_proxy:-${HTTP_PROXY:-}} FEISHU_RUNTIME_CODEX_HTTPS_PROXY=${https_proxy:-${HTTPS_PROXY:-}} FEISHU_RUNTIME_CODEX_ALL_PROXY=${all_proxy:-${ALL_PROXY:-}} FEISHU_RUNTIME_CODEX_NO_PROXY=${no_proxy:-${NO_PROXY:-}} env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY node scripts/feishu-standalone-monitor.js",
    "scheduled-jobs:runtime": "FEISHU_RUNTIME_CODEX_HTTP_PROXY=${http_proxy:-${HTTP_PROXY:-}} FEISHU_RUNTIME_CODEX_HTTPS_PROXY=${https_proxy:-${HTTPS_PROXY:-}} FEISHU_RUNTIME_CODEX_ALL_PROXY=${all_proxy:-${ALL_PROXY:-}} FEISHU_RUNTIME_CODEX_NO_PROXY=${no_proxy:-${NO_PROXY:-}} env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/scheduled-job-runner.ts",
    "remote-runner:gateway": "node scripts/remote-runner-gateway.js",
    "remote-runner:register": "node scripts/register-remote-node.js",
    "remote-runner": "node scripts/agent-platform-runner.js",
    "test:scheduled-jobs": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/scheduled-job-runner.test.ts",
    "test:long-file-detector": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/long-file-detector.test.ts",
    "test:long-file-guard": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/long-file-guard.test.ts",
    "test:auth-users": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/auth-users.test.ts",
    "test:admin-users": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/admin-users.test.ts",
    "test:pairing": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/pairing.test.ts",
    "test:remote-node-ws": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/remote-node-ws.test.ts",
    "test:acpx-harness-options": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/acpx-harness-options.test.ts",
    "test:acpx-long-file-runtime-context": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/acpx-long-file-runtime-context.test.ts",
    "test:acpx-session-tracking": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/acpx-session-tracking.test.ts",
    "check:long-files": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only scripts/check-long-files.ts",
    "test:workflow-watcher": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-watcher.test.ts",
    "test:workflow-autonomy": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-autonomy.test.ts",
    "test:new-session-rotation": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/new-session-rotation.test.ts",
    "test:workflow-session-rotation": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-session-rotation.test.ts",
    "test:workflow-roadmap-inbox": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-roadmap-inbox.test.ts",
    "test:workflow-plan-completion": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-plan-completion.test.ts",
    "build:workflow-validator": "node scripts/build-workflow-validator.mjs",
    "test:git-history-guard": "npm run build:workflow-validator && TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/git-history-guard.test.ts",
    "test:live-room-queue": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/live-room-process-registry.test.ts",
    "test:workflow-validator": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/workflow-validator.test.ts",
    "test:workflow-completion-gate": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/workflow-completion-gate.test.ts",
    "test:feishu-permission-card": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/feishu-permission-card.test.ts",
    "test:project-branch": "TS_NODE_BASEURL=. TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only -r tsconfig-paths/register tests/project-branch.test.ts",
    "workflow:validate": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only scripts/validate-workflow-documents.ts",
    "workflow:new": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only scripts/new-workflow-document.ts",
    "test:new-workflow-document": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"moduleResolution\":\"node\"}' node -r ts-node/register/transpile-only tests/new-workflow-document.test.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3010",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node prisma\\seed.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "jose": "^6.2.8",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.19.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
