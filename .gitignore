# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/

# Virtual env（不进 git；远程重建 venv + pip install）
.venv*/

# OCR 模型缓存（不进 git，每台机器各自下到 ~/.paddleocr/whl/）
models/

# 系统
.DS_Store
*.swp

# Output 产物（不进 git；Git 只保留夹具、真值、汇总报告）
output/

# 本机临时件（沙箱环境重建残留、登录二维码、测试卡片 JSON）
.tools/
.tmp_auth_qr.png
output/*.json
output/web_uploads/

# 忽略 output 下的所有日志
output/**/*.log

# 忽略特定临时目录
output/hr_debug/
output/hr_debug2/
output/holding_*/
output/s083_direct_fixes/retest*.log
output/s083_direct_fixes/diff_*.log
output/s083_direct_fixes/pytest_*.log
output/s083_direct_fixes/replay_*.log




docs/*sample*/