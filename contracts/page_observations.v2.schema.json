{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hmi:page_observations:v2",
  "title": "Pure original-screen observations",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "profile_id",
    "fields",
    "raw_field_definition_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "page_observations.v2"
    },
    "source": {
      "enum": [
        "image_recognition",
        "manual"
      ]
    },
    "profile_id": {
      "type": "string",
      "maxLength": 160
    },
    "raw_field_definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fields": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "screen_field_key",
          "source",
          "original_label",
          "original_value",
          "original_unit",
          "role",
          "state",
          "reading",
          "original_bbox"
        ],
        "properties": {
          "screen_field_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source": {
            "enum": [
              "image_recognition",
              "manual"
            ]
          },
          "original_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "original_value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ],
            "maxLength": 2048
          },
          "original_unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32
          },
          "role": {
            "enum": [
              "setting",
              "actual",
              "unknown"
            ]
          },
          "state": {
            "enum": [
              "enabled",
              "disabled",
              "unknown"
            ]
          },
          "reading": {
            "enum": [
              "known",
              "missing",
              "uncertain",
              "unsupported",
              "conflict"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "original_bbox": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "minItems": 4,
                "maxItems": 4
              }
            ]
          },
          "zone_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "zone_source": {
            "enum": [
              "nozzle",
              "barrel",
              "hot_runner",
              "mold_fixed",
              "mold_moving",
              "mold_slide",
              "other",
              null
            ]
          },
          "order": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "section": {
            "type": "string",
            "maxLength": 160
          },
          "stage": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "manual"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "type": "null"
                },
                "bbox": {
                  "type": "null"
                },
                "original_bbox": {
                  "type": "null"
                },
                "text": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "image_reference": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "raw_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recognizer": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "image_recognition"
          }
        }
      },
      "then": {
        "required": [
          "image_sha256",
          "original_size",
          "raw_contract_sha256",
          "recognizer",
          "package_sha256",
          "engine"
        ],
        "properties": {
          "image_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "original_size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fields": {
            "items": {
              "properties": {
                "source": {
                  "const": "image_recognition"
                }
              }
            }
          },
          "engine": {
            "type": "object",
            "required": [
              "library",
              "version"
            ],
            "properties": {
              "library": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "actor",
          "created_at",
          "revision"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "fields": {
            "items": {
              "properties": {
                "source": {
                  "const": "manual"
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "image_sha256"
              ]
            },
            {
              "required": [
                "recognizer"
              ]
            }
          ]
        }
      }
    }
  ]
}
